# Groq (relevance filtering + digest composition) - console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Gemini (embeddings for semantic dedup) - aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx

# Tavily (agentic web search) - app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# Telegram (delivery) - message @BotFather to create a bot
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxx

# BBC Bengali scraper - set to your deployed news-api Railway service URL
# e.g. https://your-bbc-scraper.up.railway.app/api
BBC_API_BASE=http://localhost:3000/api

# Postgres - auto-injected by Railway's Postgres plugin, no need to set manually there
DATABASE_URL=postgresql://user:password@host:port/dbname
